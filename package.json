{
  "name": "vite-plugin-private-fields",
  "version": "1.0.0",
  "description": "Remove private fields from es builds",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./typings/index.d.ts",
  "exports": {
    ".": {
      "types": "./typings/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "type": "module",
  "files": [
    "dist",
    "typings"
  ],
  "scripts": {
    "dev": "vite build --mode development",
    "build": "vite build",
    "dts": "tsc --emitDeclarationOnly --declaration --declarationDir ./typings"
  },
  "author": " <danielr@electroteque.org> (https://github.com/danielr)",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  },
  "keywords": [
    "vite",
    "vite-plugin",
    "run",
    "private",
    "fields",
    "node"
  ]
}
